#!/usr/bin/env bash
# Chrome wrapper for the G4 Chromium recorder container.
#
# The recorder launcher resolves the browser at $G4_SANDBOX/browsers/chrome/chrome, so this
# script takes that path and forwards to the real Chrome for Testing binary. It adds the
# flags every container launch needs, so recorder clients never have to send them:
#   --no-sandbox             the container has no user namespaces for the Chrome sandbox
#   --disable-dev-shm-usage  keeps Chrome stable when /dev/shm is small
#   --start-maximized        fills the virtual screen shown through VNC
set -euo pipefail

exec /opt/chrome-for-testing/chrome \
    --no-sandbox \
    --disable-dev-shm-usage \
    --start-maximized \
    "$@"
