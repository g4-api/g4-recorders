<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Assembly -->
		<TargetFramework>net10.0-windows</TargetFramework>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<!-- Unlocks System.Drawing/System.Windows.Forms for the Observe screenshot primitive (Bitmap,
		     Graphics.CopyFromScreen, SystemInformation.VirtualScreen, Application.SetHighDpiMode). -->
		<UseWindowsForms>true</UseWindowsForms>
		<AssemblyVersion>10.0.0.0</AssemblyVersion>
		<FileVersion>10.0.0.0</FileVersion>
		<IsPackable>false</IsPackable>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
		<LangVersion>latest</LangVersion>
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- https://learn.microsoft.com/en-us/dotnet/fundamentals/syslib-diagnostics/syslib1040-1049 -->
		<NoWarn>$(NoWarn);SYSLIB1045;IDE0130;SYSLIB1054;CA2101;S4200;MSB3305</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<COMReference Include="UIAutomationClient">
			<WrapperTool>tlbimp</WrapperTool>
			<VersionMinor>0</VersionMinor>
			<VersionMajor>1</VersionMajor>
			<Guid>944de083-8fb8-45cf-bcb7-c477acb2f897</Guid>
			<Lcid>0</Lcid>
			<Isolated>false</Isolated>
			<EmbedInteropTypes>false</EmbedInteropTypes>
		</COMReference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommandBridge" Version="2025.2.26.62" />
		<PackageReference Include="G4.Extensions" Version="2026.8.19.76" />
	</ItemGroup>

	<ItemGroup>
		<!-- Embeds the fixed 4-tool MCP catalog so RecorderMcpRepository can load it without touching disk at
		     runtime, matching G4.Services.Domain.V4's own Resources.SystemTools convention. -->
		<EmbeddedResource Include="Resources.SystemTools\**\*.*" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="G4.Recorders.Uia.Domain.UnitTests" />
		<InternalsVisibleTo Include="G4.Recorders.Uia.PathFinder" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\G4.Recorders.Common.Domain\G4.Recorders.Common.Domain.csproj" />
	</ItemGroup>

</Project>
